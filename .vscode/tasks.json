{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run replayWatch",
      "type": "shell",
      "command": ".\\gradlew replayWatch",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Verify (Spotless + compile + tests)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\verify.ps1",
      "problemMatcher": [
        "$gradle"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Run simulation",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\sim.ps1",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
